`ifndef CLINT_RDL
`define CLINT_RDL

addrmap clint #(
    longint unsigned NumCores = 2 // Number of cores
) {
    reg msip {
        desc = "Machine Software Interrupt Pending";
        field {
            desc = "Machine Software Interrupt Pending";
            sw = rw;
            hw = r;
        } pending[0:0] = 0x0;
        field {
            desc = "Reserved";
            sw = r;
            hw = na;
        } rsvd[31:1] = 0x0;
    };

    regfile mtimecmp {
        desc = "Machine Timer Compare";
        reg {
            desc = "Lower 32 bits of Machine Timer Compare Value";
            field {
                desc = "Timer Compare Value Low";
                sw = rw;
                hw = r;
            } value[31:0] = 0x0;
        } low;
        reg {
            desc = "Upper 32 bits of Machine Timer Compare Value";
            field {
                desc = "Timer Compare Value";
                sw = rw;
                hw = r;
            } value[31:0] = 0x0;
        } high;
    };

    regfile mtime {
        desc = "Timer Register";
        default we = true;
        reg {
            desc = "Lower 32 bits of Timer Register";
            field {
                desc = "Machine Time (Low)";
                sw = rw;
                hw = rw;
            } value[31:0] = 0x0;
        } low;
        reg {
            desc = "Upper 32 bits of Timer Register";
            field {
                desc = "Machine Time (High)";
                sw = rw;
                hw = rw;
            } value[31:0] = 0x0;
        } high;
    };

    msip msip[NumCores] @0x0;
    mtimecmp mtimecmp[NumCores] @0x4000 += 0x8;
    mtime mtime @0xBFF8;
};

`endif // CLINT_RDL
